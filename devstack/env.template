# Rendered by scripts/render-env.sh into .devstack/env (git-ignored). Never copy this to a .env at
# the repo root: Inox's config loader reads .env from its cwd and two parent directories.
APP_ENV=development
HTTP_PORT=18080
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/inox?sslmode=disable
REDIS_URL=redis://127.0.0.1:16379/0
SESSION_SECRET=local-dev-only-not-a-secret-0123456789abcdef
# Deliberately unreachable: Inox falls back to local-disk storage at boot.
MINIO_ENDPOINT=127.0.0.1:1
STORAGE_DIR=${FIREOS_ROOT}/.devstack/storage
# Baked into stored asset URLs; must be reachable from both the VVD and the host browser.
MEDIA_STREAM_BASE_URL=http://${DEV_HOST}:18080/media/stream
LIVE_PROXY_BASE_URL=http://${DEV_HOST}:18080/api/v1/live
LIVE_BROWSER_PATH=off
CORS_ALLOWED_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:18080
ADMIN_EMAILS=admin@fireos-inox.test
